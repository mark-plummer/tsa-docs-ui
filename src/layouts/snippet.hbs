<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
{{> head defaultPageTitle='Untitled' noCookieyes=true noGTM=true noLlmsTxt=true}}
  </head>
  <body class="article snippet">
    <div style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;">
      <a href="https://docs.thoughtspot.com/llms.txt">LLMs.txt directory</a>
    </div>
<main class="snippet-main">
  <div class="content">
    <article class="doc">
{{#with page.title}}
<h1 class="page">{{{this}}}</h1>
{{/with}}
{{{page.contents}}}
    </article>
  </div>
</main>
{{> footer-scripts}}
  </body>
</html>
